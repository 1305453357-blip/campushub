page{background:#f4faf9;color:#203d3b;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}view,text,input,textarea,button{box-sizing:border-box}.page{padding:32rpx 28rpx 60rpx}.hero{background:linear-gradient(135deg,#087f82,#13b4a0);border-radius:32rpx;padding:40rpx 32rpx;color:white;margin-bottom:30rpx}.brand{font-size:48rpx;font-weight:800;letter-spacing:2rpx}.subtitle{opacity:.85;font-size:25rpx;margin-top:12rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.section{font-size:34rpx;font-weight:700;margin:32rpx 0 20rpx}.card{background:#fff;border:1rpx solid #e2efed;border-radius:24rpx;padding:26rpx;margin-bottom:20rpx}.muted{color:#7b918d;font-size:24rpx;line-height:1.7}.title{font-size:30rpx;font-weight:650;line-height:1.5}.price{color:#079b91;font-size:36rpx;font-weight:750;margin:12rpx 0}.pill{display:inline-block;background:#e5f6f2;color:#087f82;padding:8rpx 18rpx;border-radius:30rpx;font-size:23rpx}.school{background:#fff;border-radius:18rpx;padding:22rpx;margin-bottom:20rpx;color:#087f82}.search{background:white;border:1rpx solid #dfebe8;border-radius:18rpx;padding:22rpx;margin-bottom:20rpx}.filters{white-space:nowrap;margin:18rpx 0 24rpx}.filter{display:inline-block;padding:14rpx 24rpx;margin-right:14rpx;border-radius:28rpx;background:#fff;color:#728982}.selected{background:#079b91;color:#fff}.placeholder{height:150rpx;background:linear-gradient(135deg,#e4f5f1,#ddecf9);border-radius:18rpx;display:flex;align-items:center;justify-content:center;color:#468b88;font-weight:700;margin-bottom:18rpx}.large{height:320rpx;font-size:44rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.grid .card{margin:0}.primary{background:#079b91!important;color:white!important;border-radius:18rpx;font-size:28rpx;margin-top:22rpx}.secondary{background:#e5f6f2!important;color:#087f82!important;border-radius:18rpx;font-size:27rpx;margin-top:18rpx}button::after{border:0}.empty{text-align:center;padding:60rpx 22rpx;color:#7b918d}.field{margin-bottom:26rpx}.label{display:block;font-weight:600;margin-bottom:14rpx}.control{width:100%;background:#f3f8f7;border-radius:14rpx;padding:22rpx;min-height:84rpx}input.control{height:88rpx}textarea.control{height:230rpx}.description{white-space:pre-wrap;word-break:break-all;line-height:1.9;margin-top:20rpx}.notice{background:#e7f3fb;color:#517887;padding:20rpx;border-radius:16rpx;font-size:24rpx;line-height:1.7;margin-bottom:22rpx}.avatar{width:100rpx;height:100rpx;background:#d7f2ea;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#079b91;font-size:40rpx}.actions{display:flex;gap:16rpx}.actions button{flex:1}.tiny{font-size:22rpx;color:#8ba29c}
