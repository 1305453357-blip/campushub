<view class="page"><view class="card row"><view class="avatar">校</view><view><view class="title">{{user.name}}</view><view class="muted">{{user.subtitle}}</view></view><view class="pill">体验中</view></view><view class="notice">无真实登录。我的发布仅保存在本机，清除开发者工具缓存后将移除。</view><view class="actions"><button class="secondary" bindtap="publishProduct">发布商品</button><button class="secondary" bindtap="publishNeed">发布需求</button></view><view class="section">我的商品 · {{products.length}}</view><view class="card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct"><view class="placeholder">{{item.badge}}</view><view class="title">{{item.title}}</view><view class="price">¥ {{item.price}}</view><view class="muted">{{item.school}} · {{item.category}}</view></view><view wx:if="{{!products.length}}" class="empty">还没有发布商品</view><view class="section">我的需求 · {{needs.length}}</view><view class="card" wx:for="{{needs}}" wx:key="id" data-id="{{item.id}}" bindtap="openNeed"><view class="pill">{{item.category}}</view><view class="title">{{item.title}}</view><view class="muted">{{item.school}}</view></view><view wx:if="{{!needs.length}}" class="empty">还没有发布需求</view></view>
