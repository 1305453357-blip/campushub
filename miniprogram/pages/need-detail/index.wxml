<view class="page"><block wx:if="{{item}}"><view class="notice">本地演示信息，不支持实际交易或联系。</view><view class="card"><view class="title">{{item.title}}</view><view class="muted">{{item.school}} · {{item.category}}</view><view class="description">{{item.description}}</view><view class="section">模拟联系方式</view><view class="description">{{item.contact}}</view></view><button class="secondary" bindtap="notice">仅供演示 · 无法联系</button></block><view wx:else class="empty">内容不存在或已清除<button class="secondary" bindtap="back">返回列表</button></view></view>
