<view class="page"><block wx:if="{{item}}"><view class="notice">本地演示信息，不支持实际交易或联系。</view><view class="card"><view class="placeholder large">{{item.badge}} · 图片占位</view><view class="price">¥ {{item.price}}</view><view class="title">{{item.title}}</view><view class="muted">{{item.school}} · {{item.category}}</view><view class="description">{{item.description}}</view></view><button class="secondary" bindtap="notice">交易功能尚未开放</button></block><view wx:else class="empty">内容不存在或已清除<button class="secondary" bindtap="back">返回列表</button></view></view>
