<view class="page"><view class="row"><view class="section">二手市场</view><text class="pill">本地演示</text></view><picker class="school" range="{{schools}}" value="{{schoolIndex}}" bindchange="changeSchool"><view>学校 · {{school}} ▾</view></picker><input class="search" placeholder="搜索标题或描述" value="{{keyword}}" maxlength="40" bindinput="search"/><scroll-view scroll-x class="filters"><text wx:for="{{categories}}" wx:key="*this" class="filter {{category === item ? 'selected' : ''}}" data-category="{{item}}" bindtap="filter">{{item}}</text></scroll-view><button class="primary" bindtap="publish">发布闲置商品</button><view class="section">发现好物</view><view class="card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct"><view class="placeholder">{{item.badge}}</view><view class="title">{{item.title}}</view><view class="price">¥ {{item.price}}</view><view class="muted">{{item.school}} · {{item.category}}</view></view><view wx:if="{{!products.length}}" class="empty">暂无匹配内容，试试切换学校或分类</view></view>
